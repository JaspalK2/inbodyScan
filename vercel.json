{
  "version": 2,
  "builds": [
    {
      "src": "frontend/api/auth/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["frontend/api/auth/**", "services/auth-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "frontend/api/users/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["frontend/api/users/**", "services/user-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "frontend/api/scans/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 20, "includeFiles": ["frontend/api/scans/**", "services/scan-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "frontend/api/analytics/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["frontend/api/analytics/**", "services/analytics-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "frontend/api/recommendations/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 30, "includeFiles": ["frontend/api/recommendations/**", "services/recommendation-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "frontend/api/admin/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["frontend/api/admin/**", "services/admin-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "/frontend/api/auth/[...path]?path=$1" },
    { "src": "/api/users/(.*)", "dest": "/frontend/api/users/[...path]?path=$1" },
    { "src": "/api/scans/(.*)", "dest": "/frontend/api/scans/[...path]?path=$1" },
    { "src": "/api/analytics/(.*)", "dest": "/frontend/api/analytics/[...path]?path=$1" },
    { "src": "/api/recommendations/(.*)", "dest": "/frontend/api/recommendations/[...path]?path=$1" },
    { "src": "/api/admin/(.*)", "dest": "/frontend/api/admin/[...path]?path=$1" }
  ]
}
