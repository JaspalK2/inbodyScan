{
  "version": 2,
  "builds": [
    {
      "src": "services/auth-service/src/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 15,
        "includeFiles": [
          "requirements.txt",
          "services/auth-service/src/**",
          "shared/**"
        ]
      }
    },
    {
      "src": "services/user-service/src/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 15,
        "includeFiles": [
          "requirements.txt",
          "services/user-service/src/**",
          "shared/**"
        ]
      }
    },
    {
      "src": "services/scan-service/src/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 20,
        "includeFiles": [
          "requirements.txt",
          "services/scan-service/src/**",
          "shared/**"
        ]
      }
    },
    {
      "src": "services/analytics-service/src/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 15,
        "includeFiles": [
          "requirements.txt",
          "services/analytics-service/src/**",
          "shared/**"
        ]
      }
    },
    {
      "src": "services/recommendation-service/src/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "requirements.txt",
          "services/recommendation-service/src/**",
          "shared/**"
        ]
      }
    },
    {
      "src": "services/admin-service/src/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 15,
        "includeFiles": [
          "requirements.txt",
          "services/admin-service/src/**",
          "shared/**"
        ]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "services/auth-service/src/main.py" },
    { "src": "/api/users/(.*)", "dest": "services/user-service/src/main.py" },
    { "src": "/api/scans/(.*)", "dest": "services/scan-service/src/main.py" },
    { "src": "/api/analytics/(.*)", "dest": "services/analytics-service/src/main.py" },
    { "src": "/api/recommendations/(.*)", "dest": "services/recommendation-service/src/main.py" },
    { "src": "/api/admin/(.*)", "dest": "services/admin-service/src/main.py" },
    { "src": "/(.*)", "dest": "frontend" }
  ]
}
