{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "/api/auth/[...path]?path=$1" },
    { "src": "/api/users/(.*)", "dest": "/api/users/[...path]?path=$1" },
    { "src": "/api/scans/(.*)", "dest": "/api/scans/[...path]?path=$1" },
    { "src": "/api/analytics/(.*)", "dest": "/api/analytics/[...path]?path=$1" },
    { "src": "/api/recommendations/(.*)", "dest": "/api/recommendations/[...path]?path=$1" },
    { "src": "/api/admin/(.*)", "dest": "/api/admin/[...path]?path=$1" }
  ]
}
