{
  "version": 2,
  "builds": [
    {
      "src": "api/auth/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["services/auth-service/src/**", "shared/**"] }
    },
    {
      "src": "api/users/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["services/user-service/src/**", "shared/**"] }
    },
    {
      "src": "api/scans/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 20, "includeFiles": ["services/scan-service/src/**", "shared/**"] }
    },
    {
      "src": "api/analytics/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["services/analytics-service/src/**", "shared/**"] }
    },
    {
      "src": "api/recommendations/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 30, "includeFiles": ["services/recommendation-service/src/**", "shared/**"] }
    },
    {
      "src": "api/admin/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["services/admin-service/src/**", "shared/**"] }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "/api/auth/[...path]?path=$1" },
    { "src": "/api/users/(.*)", "dest": "/api/users/[...path]?path=$1" },
    { "src": "/api/scans/(.*)", "dest": "/api/scans/[...path]?path=$1" },
    { "src": "/api/analytics/(.*)", "dest": "/api/analytics/[...path]?path=$1" },
    { "src": "/api/recommendations/(.*)", "dest": "/api/recommendations/[...path]?path=$1" },
    { "src": "/api/admin/(.*)", "dest": "/api/admin/[...path]?path=$1" }
  ]
}
