{
  "version": 2,
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "/api/auth/[...path]" },
    { "src": "/api/users/(.*)", "dest": "/api/users/[...path]" },
    { "src": "/api/scans/(.*)", "dest": "/api/scans/[...path]" },
    { "src": "/api/analytics/(.*)", "dest": "/api/analytics/[...path]" },
    { "src": "/api/recommendations/(.*)", "dest": "/api/recommendations/[...path]" },
    { "src": "/api/admin/(.*)", "dest": "/api/admin/[...path]" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "builds": [
    {
      "src": "api/auth/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["api/auth/**", "services/auth-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "api/users/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["api/users/**", "services/user-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "api/scans/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 20, "includeFiles": ["api/scans/**", "services/scan-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "api/analytics/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["api/analytics/**", "services/analytics-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "api/recommendations/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 30, "includeFiles": ["api/recommendations/**", "services/recommendation-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "api/admin/[...path].py",
      "use": "@vercel/python",
      "config": { "maxDuration": 15, "includeFiles": ["api/admin/**", "services/admin-service/src/**", "shared/**", "requirements.txt"] }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ]
}
