{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "cd frontend && npm install",
  "functions": {
    "api/auth/[...path].py": { "maxDuration": 15 },
    "api/users/[...path].py": { "maxDuration": 15 },
    "api/scans/[...path].py": { "maxDuration": 20 },
    "api/analytics/[...path].py": { "maxDuration": 15 },
    "api/recommendations/[...path].py": { "maxDuration": 30 },
    "api/admin/[...path].py": { "maxDuration": 15 },
    "api/debug/[...path].py": { "maxDuration": 10 }
  }
}
