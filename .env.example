# ============================================================
# InBody Scan Analyzer — Environment Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-jwt>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>
SUPABASE_STORAGE_BUCKET=scan-pdfs

# --- Database (Supabase PostgreSQL — Transaction pooler) ---
# Format: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
AUTH_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres
USER_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres
SCAN_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres
ANALYTICS_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres
RECOMMENDATION_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# --- JWT ---
JWT_SECRET_KEY=<random-64-char-hex>   # generate: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin account ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<strong-password>

# --- LLM ---
GOOGLE_API_KEY=<gemini-api-key>

# --- USDA Food Data Central ---
USDA_API_KEY=<usda-api-key>           # free at https://fdc.nal.usda.gov/api-guide/

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000
